# .env.example — copy this to .env and fill in your real values.
# NEVER commit .env to source control.

DB_HOST=localhost
DB_USER=your_db_username
DB_PASS=your_db_password
DB_NAME=your_db_name

# Shop email
URTH_MAIL_FROM=no-reply@urthspaces.com
# New shop orders are sent here (defaults to sales@shop.urthspaces.com if unset)
URTH_SHOP_ORDER_EMAIL=sales@shop.urthspaces.com

# Send shop email through an authenticated SMTP mailbox (recommended on Hostinger/Titan).
# When URTH_SMTP_HOST is set, URTH_MAIL_FROM must be the same mailbox as URTH_SMTP_USER.
URTH_SMTP_HOST=smtp.titan.email
URTH_SMTP_PORT=465
URTH_SMTP_USER=sales@shop.urthspaces.com
URTH_SMTP_PASS=your_mailbox_password
